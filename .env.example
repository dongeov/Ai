APP_PORT=5000
APP_HOST=0.0.0.0
APP_DEBUG=false
SECRET_KEY=

# ============================================
# CLOUD LLM (PRIMARY) — mimo-v2.5 via Zen
# Yêu cầu: cùng API key với mimo-v2.5, base URL https://opencode.ai/zen
# (Client tự append /v1/chat/completions; nếu bạn điền full
#  https://opencode.ai/zen/v1/chat/completions sẽ được normalize về base)
# ============================================
LLM_CLOUD_ENABLED=true
LLM_CLOUD_URL=https://opencode.ai/zen/v1
LLM_CLOUD_MODEL=mimo-v2.5
LLM_CLOUD_API_KEY=your-api-key-here
LLM_CLOUD_REPLICAS=8
# Cloud endpoint #2 — parallel, same API key (failover: cloud1 <-> cloud2 -> local)
LLM_CLOUD_URL2=https://opencode.ai/zen/go/v1
LLM_CLOUD_MODEL2=mimo-v2.5
LLM_CLOUD_REPLICAS2=8

# ============================================
# LM STUDIO (LOCAL FALLBACK + EMBEDDING + VISION)
# ============================================
LM_STUDIO_HOST=http://localhost:1234/v1
LM_STUDIO_EMBEDDING_URL=http://localhost:1234/v1/embeddings

# LLM Load Balancing - Format: url|model_name|replicas
LLM_ENDPOINTS=http://localhost:1234|mistralai/ministral-3-3b|1
LLM_STRATEGY=priority
LLM_HEALTH_CHECK_INTERVAL=30
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_TIMEOUT=60
LLM_TIMEOUT=300
LLM_CONNECT_TIMEOUT=10

# Embedding Load Balancing - Format: url|model_name|replicas
EMBEDDING_ENDPOINTS=http://localhost:1234|text-embedding-bge-m3|1
EMBEDDING_STRATEGY=least_latency
EMBEDDING_HEALTH_CHECK_INTERVAL=30

LLM_MODEL=mimo-v2.5
VISION_MODEL=
EMBEDDING_MODEL=text-embedding-bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

CHUNK_SIZE=512
CHUNK_OVERLAP=50

CHROMA_DB_PATH=./models/chroma_db
COLLECTION_NAME=ai_knowledge_base

OBSIDIAN_VAULT_PATH=./data/obsidian_vault

LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ============================================
# RAG ACCURACY
# ============================================
SCORE_THRESHOLD=0.3
RETRIEVAL_TOP_K=12
MAX_CONTEXT_CHARS=60000
MMR_LAMBDA=0.5
BM25_LIMIT=10000
CONVERSATION_MAX_MESSAGES=20
MAX_UPLOAD_MB=50

# ============================================
# ADVANCED RAG
# ============================================
USE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=12

USE_CONTEXT_COMPRESSION=false
MAX_CONTEXT_TOKENS=3000

USE_RELEVANCE_JUDGE=true
USE_FAITHFULNESS_CHECK=false
FAITHFULNESS_THRESHOLD=0.5
MAX_REFINEMENT_ITERATIONS=2

# ============================================
# SAG (Structured Augmented Generation)
# ============================================
SAG_ENABLED=true
SAG_DB_PATH=./models/sag.db
SAG_LANGUAGE=vi
SAG_CHUNK_MAX_TOKENS=1000
SAG_SEARCH_STRATEGY=multi
SAG_EVENT_EXTRACTION_ENABLED=true
SAG_ENTITY_TYPES=person,organization,location,concept,event,product
SAG_GRAPH_EVENT_LIMIT=50
SAG_CHAT_ENABLED=false
SAG_DEFAULT_SOURCE_ID=
SAG_HYBRID_WEIGHT=0.6
CHROMA_HYBRID_WEIGHT=0.4

# ============================================
# IMAGE FILTER — Smart icon/logo/decorative filtering
# ============================================
IMAGE_FILTER_MIN_WIDTH=64
IMAGE_FILTER_MIN_HEIGHT=64
IMAGE_FILTER_MIN_ENTROPY=3.0
IMAGE_FILTER_MAX_WHITE_RATIO=0.85
IMAGE_FILTER_MIN_UNIQUE_COLORS=30
IMAGE_FILTER_USE_LLM=false
