# AI Chatbox Configuration
# Cloud primary (MiMo-V2.5) + Local fallback (LM Studio)

# ============================================
# CLOUD LLM (PRIMARY) — mimo-v2.5 via Zen GO gateway
# Base URL https://opencode.ai/zen/go → final endpoint https://opencode.ai/zen/go/v1/chat/completions
# Endpoint zen thường (/zen/v1) bị gateway chặn policy với key free → đã bỏ, chỉ giữ bản go.
# ============================================
LLM_CLOUD_ENABLED=true
LLM_CLOUD_URL=https://opencode.ai/zen/go/v1
LLM_CLOUD_MODEL=mimo-v2.5
LLM_CLOUD_API_KEY=sk-0X8lvhlXkUWELeBcFglt8CCeRSmTm88zS0rJg8wD5Om4Z2YkChmM7vTeKdA727tx
LLM_CLOUD_REPLICAS=8
# Trống = tắt endpoint cloud #2 (tránh trùng lặp với primary đã là go)
LLM_CLOUD_URL2=
LLM_CLOUD_MODEL2=mimo-v2.5
LLM_CLOUD_REPLICAS2=8

# ============================================
# LM STUDIO (LOCAL ONLY FOR EMBEDDING + VISION)
# ============================================
LM_STUDIO_HOST=http://localhost:1234/v1
LM_STUDIO_EMBEDDING_URL=http://localhost:1234/v1/embeddings

# Local LLM fallback (LM Studio) — 2 instances chạy song song chia tải
# (strategy=priority: cùng priority=2 → router chia request theo least-active-requests)
LLM_ENDPOINTS=http://localhost:1234|mistralai/ministral-3-3b|8,http://localhost:1234|mistralai/ministral-3-3b:2|8
LLM_STRATEGY=priority
LLM_HEALTH_CHECK_INTERVAL=30
LLM_CIRCUIT_BREAKER_THRESHOLD=20
LLM_CIRCUIT_BREAKER_TIMEOUT=10
LLM_TIMEOUT=300
# Connect riêng: treo kết nối quá 10s → chuyển fallback ngay (đọc stream vẫn tới 300s)
LLM_CONNECT_TIMEOUT=10

# Embedding Load Balancing (local only)
EMBEDDING_ENDPOINTS=http://localhost:1234|text-embedding-bge-m3|24
EMBEDDING_STRATEGY=least_connections
EMBEDDING_HEALTH_CHECK_INTERVAL=30
EMBEDDING_CIRCUIT_BREAKER_THRESHOLD=10
EMBEDDING_CIRCUIT_BREAKER_TIMEOUT=30

# ============================================
# MODELS — mimo-v2.5 via Zen GO is main
# ============================================
LLM_MODEL=mimo-v2.5
EMBEDDING_MODEL=text-embedding-bge-m3
VISION_MODEL=mistralai/ministral-3-3b

# ============================================
# TOKEN LIMITS
# ============================================
MAX_OUTPUT_TOKENS=5000
THINKING_TOKENS=5000
REASONING_EFFORT=low

# ============================================
# EMBEDDING SETTINGS
# ============================================
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_WORKERS=9

# ============================================
# CHUNKING SETTINGS
# ============================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ============================================
# DATA & OBSIDIAN
# ============================================
OBSIDIAN_VAULT_PATH=G:\ai-chatbox\data\obsidian_vault
DATA_DIR=data
DATARAW_DIR=dataraw
MODELS_DIR=models

# ============================================
# APP SETTINGS
# ============================================
APP_DEBUG=false
APP_PORT=5000
APP_HOST=0.0.0.0
SECRET_KEY=238ddb91ea6e7d7ca85d7528df362fe7c6ba2f522934ce7a6ba0937cfa96744a
API_KEY=
ADMIN_PASSWORD=01121998
LOG_LEVEL=INFO

# ============================================
# RAG SETTINGS
# ============================================
COLLECTION_NAME=chatbot_docs
SCORE_THRESHOLD=0.3
RETRIEVAL_TOP_K=12
MAX_CONTEXT_CHARS=60000
MMR_LAMBDA=0.5
BM25_LIMIT=10000
CONVERSATION_MAX_MESSAGES=20
MAX_HISTORY_TOKENS=500
MAX_UPLOAD_MB=50

# ============================================
# SAG (Structured Augmented Generation)
# ============================================
SAG_CHAT_ENABLED=true
SAG_DEFAULT_SOURCE_ID=
SAG_SEARCH_STRATEGY=multi

# ============================================
# ADVANCED RAG — RETRIEVAL
# ============================================
USE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=12

# ============================================
# ADVANCED RAG — POST-RETRIEVAL
# ============================================
USE_CONTEXT_COMPRESSION=false
MAX_CONTEXT_TOKENS=3000

# ============================================
# ADVANCED RAG — SELF-RAG
# ============================================
USE_RELEVANCE_JUDGE=false
USE_FAITHFULNESS_CHECK=false
FAITHFULNESS_THRESHOLD=0.5
MAX_REFINEMENT_ITERATIONS=2

# ============================================
# IMAGE FILTER — Smart icon/logo/decorative filtering
# ============================================
IMAGE_FILTER_MIN_WIDTH=64
IMAGE_FILTER_MIN_HEIGHT=64
IMAGE_FILTER_MIN_ENTROPY=3.0
IMAGE_FILTER_MAX_WHITE_RATIO=0.85
IMAGE_FILTER_MIN_UNIQUE_COLORS=30
IMAGE_FILTER_USE_LLM=false

# ============================================
# MODEL DISCOVERY & AUTO-FAILOVER
# ============================================
MODEL_DISCOVERY_ENABLED=false
MODEL_DISCOVERY_POLL_INTERVAL=10

# ============================================
# PARALLEL WORKERS
# ============================================
RELEVANCE_JUDGE_WORKERS=24
CONTEXT_COMPRESS_WORKERS=24
CHUNK_ANALYZER_WORKERS=24
FILE_PROCESS_WORKERS=8
IMAGE_FILTER_WORKERS=24
IMAGE_DESCRIBE_WORKERS=24

# --- Scale to 1000 concurrent users (ExploraScience) ---
# Cloud concurrency cap = in-flight requests to Zen gateway (match key quota).
# Excess waits in local queue up to CLOUD_QUEUE_TIMEOUT seconds, then local fallback.
CLOUD_MAX_CONCURRENT=32
CLOUD_QUEUE_TIMEOUT=30
# Short circuit cool-down after a cloud 429 (seconds) - was 300s before
LLM_429_COOLDOWN=20
# Per-IP token bucket (kiosk NAT friendly)
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_RATE=10
# FAQ answer cache (identical question served instantly, 0 = disabled)
ANSWER_CACHE_TTL=900
SAG_HYBRID_WEIGHT=0.4
CHROMA_HYBRID_WEIGHT=0.6
